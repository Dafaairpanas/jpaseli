---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import '../styles/kotoba-global.css';
---

<Layout title="Kamus Kotoba - JPASELI">
  <div class="kt-app">
    <Header 
      title="Kamus Kosakata (Kotoba)" 
      subtitle="Belajar Kosakata Jepang Terpadu" 
      icon='<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-book-open-text"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/><path d="M6 8h2"/><path d="M6 12h2"/><path d="M16 8h2"/><path d="M16 12h2"/></svg>'
    />

    <!-- Search Section -->
    <div class="kt-search-section">
      <div class="kt-search-wrapper">
        <svg class="kt-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input type="text" id="search-input" class="kt-search-input" placeholder="Cari berdasarkan Hiragana, Katakana, Romaji, Kanji, atau arti kata..." autocomplete="off" />
      </div>
      
      <div class="kt-filters">
        <select id="filter-bab" class="kt-filter-select">
          <option value="all">Semua Bab</option>
        </select>
        
        <label class="kt-chk-label">
          <input type="checkbox" id="chk-only-extra" /> Hanya Kosakata Ekstra
        </label>
        
        <div style="margin-left: auto; display: flex; gap: 0.5rem; align-items: center; font-size: 0.85rem; font-weight: 600;">
          <span>TTS:</span>
          <select id="tts-speed" style="padding: 0.3rem; border-radius: 6px; background: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-main); font-family: inherit; font-size: 0.8rem; cursor: pointer;">
            <option value="0.85">0.85x</option>
            <option value="1.0" selected>1.0x</option>
            <option value="1.2">1.2x</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Stats Banner -->
    <div class="kt-stats" id="stats-banner" style="display:none;">
      <span id="stats-count">Memuat data...</span>
    </div>

    <!-- Loading State -->
    <div class="kt-loading" id="loading-spinner">
      <div class="kt-spinner"></div>
      <span>Memuat semua kosakata...</span>
    </div>

    <!-- Grid Container -->
    <div class="kt-grid" id="kotoba-grid" style="display:none;"></div>

    <!-- Empty State -->
    <div class="kt-empty" id="empty-state" style="display:none;">
      Tidak ada kosakata yang cocok dengan pencarian Anda.
    </div>

    <!-- Load More Button -->
    <div class="kt-loadmore-wrapper" id="loadmore-wrapper" style="display:none;">
      <button class="btn-loadmore" id="btn-loadmore">Muat Lebih Banyak</button>
    </div>

    <!-- footer -->
    <footer style="margin-top: auto; padding-top: 2rem; border-top: 1px solid var(--border-color); text-align: center; color: var(--text-muted); font-size: 0.95rem;">
      <p>Dibuat oleh <strong>Aditya Rasya Dafa Putra</strong></p>
    </footer>
  </div>

  <script>
    import '../scripts/kotoba.js';
  </script>
</Layout>

