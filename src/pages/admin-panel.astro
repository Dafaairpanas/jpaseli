---
import '../styles/global.css';
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Panel - JPASELI</title>
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />
  <style>
    .admin-wrap { max-width: 1200px; margin: 0 auto; padding: 2rem; min-height: 100vh; }

    /* Stats Cards */
    .stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-bottom: 2rem; }
    .stat-card { background: var(--bg-secondary); border: 1px solid var(--border-color); padding: 1.5rem; text-align: center; border-radius: 8px; }
    .stat-card .stat-num { font-size: 2.5rem; font-weight: 800; }
    .stat-card .stat-label { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; margin-top: 0.5rem; }

    /* Tabs */
    .tabs { display: flex; gap: 0; border-bottom: 2px solid var(--border-color); margin-bottom: 2rem; }
    .tab-btn { background: transparent; border: none; color: var(--text-muted); padding: 1rem 2rem; font-size: 1rem; font-weight: 700; cursor: pointer; border-bottom: 3px solid transparent; margin-bottom: -2px; transition: all 0.2s; font-family: inherit; text-transform: uppercase; letter-spacing: 0.05em; }
    .tab-btn.active { color: var(--text-main); border-bottom-color: var(--accent); }
    .tab-btn:hover { color: var(--text-main); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }

    /* Day List Table */
    .day-table { width: 100%; border-collapse: collapse; }
    .day-table th, .day-table td { padding: 1rem 1.25rem; text-align: left; border-bottom: 1px solid var(--border-color); font-size: 0.95rem; }
    .day-table th { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); background: var(--bg-secondary); position: sticky; top: 0; }
    .day-table tr:hover td { background: var(--highlight-bg); }
    .day-table .num { font-weight: 800; font-size: 1.2rem; }

    /* Buttons */
    .btn-sm { padding: 0.4rem 0.8rem; font-size: 0.75rem; font-weight: 700; border: 1px solid var(--border-color); background: transparent; color: var(--text-main); cursor: pointer; border-radius: 4px; transition: all 0.2s; font-family: inherit; text-transform: uppercase; letter-spacing: 0.05em; }
    .btn-sm:hover { background: var(--text-main); color: var(--bg-secondary); }
    .btn-danger { border-color: #ff5252; color: #ff5252; }
    .btn-danger:hover { background: #ff5252; color: #fff; }
    .btn-accent { border-color: var(--accent); color: var(--accent); }
    .btn-accent:hover { background: var(--accent); color: #000; }

    /* Detail Panel */
    .detail-panel { background: var(--bg-secondary); border: 1px solid var(--border-color); padding: 2rem; border-radius: 8px; margin-top: 1rem; }
    .detail-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color); }
    .detail-header h2 { font-size: 2rem; margin: 0; }

    /* Section cards in detail */
    .section-title { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 700; margin-bottom: 1rem; margin-top: 2rem; }
    .item-row { display: flex; justify-content: space-between; align-items: flex-start; padding: 1rem; border: 1px solid var(--border-color); border-radius: 6px; margin-bottom: 0.5rem; gap: 1rem; }
    .item-row:hover { background: var(--highlight-bg); }
    .item-info { flex: 1; }
    .item-info .main-text { font-size: 1.3rem; font-weight: 700; }
    .item-info .sub-text { font-size: 0.9rem; color: var(--text-muted); margin-top: 0.25rem; }
    .item-id { font-size: 0.75rem; color: var(--text-muted); font-family: monospace; }

    /* Toast notifications */
    .toast { position: fixed; bottom: 2rem; right: 2rem; padding: 1rem 2rem; border-radius: 8px; font-weight: 600; z-index: 9999; transition: all 0.3s; transform: translateY(100px); opacity: 0; }
    .toast.show { transform: translateY(0); opacity: 1; }
    .toast.success { background: #10b981; color: #000; }
    .toast.error { background: #ff5252; color: #fff; }

    /* Confirm dialog */
    .confirm-overlay { display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); z-index: 9998; justify-content: center; align-items: center; }
    .confirm-overlay.show { display: flex; }
    .confirm-box { background: var(--bg-secondary); border: 2px solid var(--border-color); padding: 2rem; border-radius: 8px; max-width: 450px; width: 90%; text-align: center; }
    .confirm-box h3 { font-size: 1.5rem; margin-bottom: 1rem; }
    .confirm-box p { color: var(--text-muted); margin-bottom: 2rem; font-size: 1rem; }
    .confirm-btns { display: flex; gap: 1rem; justify-content: center; }
    .confirm-btns button { padding: 0.75rem 2rem; font-size: 0.9rem; font-weight: 700; border-radius: 4px; cursor: pointer; font-family: inherit; }

    /* Loading */
    .loading { text-align: center; padding: 4rem; color: var(--text-muted); font-size: 1.2rem; }

    /* Template Form */
    .tpl-form { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.5rem; margin-bottom: 2rem; display: flex; flex-direction: column; gap: 1rem; }
    .tpl-form h3 { font-size: 1.2rem; margin: 0; }
    .tpl-input { width: 100%; padding: 0.75rem 1rem; font-size: 0.95rem; border: 1px solid var(--border-color); background: var(--bg-primary); color: var(--text-main); border-radius: 6px; outline: none; font-family: inherit; transition: border-color 0.2s; }
    .tpl-input:focus { border-color: var(--accent); }
    .tpl-input-sm { padding: 0.6rem 1rem; font-size: 0.9rem; }
    .tpl-textarea { min-height: 150px; resize: vertical; font-family: 'Courier New', monospace; font-size: 0.85rem; line-height: 1.5; }
    .tpl-row { display: flex; gap: 1rem; }
    .tpl-row > * { flex: 1; }
    .tpl-card { background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 1.25rem; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; transition: background 0.2s; }
    .tpl-card:hover { background: var(--highlight-bg); }
    .tpl-card-info { flex: 1; }
    .tpl-card-name { font-size: 1.1rem; font-weight: 700; }
    .tpl-card-desc { font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem; }
    .tpl-card-meta { font-size: 0.75rem; color: var(--accent); font-weight: 600; margin-top: 0.35rem; }
    .tpl-list { display: flex; flex-direction: column; gap: 0.6rem; }

    @media (max-width: 768px) {
      .stats-grid { grid-template-columns: repeat(2, 1fr); }
      .tabs { overflow-x: auto; }
      .tab-btn { padding: 0.75rem 1rem; font-size: 0.85rem; white-space: nowrap; }
      .detail-header { flex-direction: column; gap: 1rem; align-items: flex-start; }
      .tpl-row { flex-direction: column; }
    }
  </style>
</head>
<body data-theme="dark">
  <div class="admin-wrap">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; padding-bottom: 1.5rem; border-bottom: 2px solid var(--border-color);">
      <div style="display: flex; align-items: center; gap: 1rem;">
        <div style="color: var(--accent);"><svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.5 3.8 17 5 19 5a1 1 0 0 1 1 1z"/></svg></div>
        <div>
          <h1 style="font-size: 2.5rem; margin: 0;">ADMIN PANEL</h1>
          <p style="color: var(--text-muted); margin-top: 0.5rem;">Kelola seluruh data materi JPASELI</p>
        </div>
      </div>
      <div style="display: flex; gap: 0.75rem;">
        <a href="/" class="btn-sm btn-accent" style="padding: 0.6rem 1.2rem;">HOME</a>
        <a href="/admin" class="btn-sm" style="padding: 0.6rem 1.2rem;">IMPORT JSON</a>
      </div>
    </div>

    <!-- Stats -->
    <div class="stats-grid" id="stats-grid">
      <div class="stat-card"><div class="stat-num" id="stat-days">-</div><div class="stat-label">Total Day</div></div>
      <div class="stat-card"><div class="stat-num" id="stat-bunpou">-</div><div class="stat-label">Bunpou</div></div>
      <div class="stat-card"><div class="stat-num" id="stat-kanji">-</div><div class="stat-label">Kanji</div></div>
      <div class="stat-card"><div class="stat-num" id="stat-kotoba">-</div><div class="stat-label">Kotoba</div></div>
    </div>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab-btn active" data-tab="days">Daftar Day</button>
      <button class="tab-btn" data-tab="detail">Detail Materi</button>
      <button class="tab-btn" data-tab="template">Template FC</button>
      <button class="tab-btn" data-tab="bunpo-tpl">Template Bunpo</button>
    </div>

    <!-- Tab: Daftar Day -->
    <div class="tab-panel active" id="tab-days">
      <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; align-items: center;">
        <input type="number" class="search-bar" id="filter-day" placeholder="Filter nomor Day..." style="flex: 1; padding: 0.8rem 1.5rem; font-size: 1rem;" />
      </div>
      <div style="max-height: 60vh; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px;">
        <table class="day-table">
          <thead>
            <tr>
              <th>Day</th>
              <th>Bunpou</th>
              <th>Kanji</th>
              <th>Kotoba</th>
              <th>Total</th>
              <th style="text-align: right;">Aksi</th>
            </tr>
          </thead>
          <tbody id="days-tbody">
            <tr><td colspan="6" class="loading">Memuat data...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Tab: Detail Materi -->
    <div class="tab-panel" id="tab-detail">
      <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; align-items: center;">
        <input type="number" class="search-bar" id="goto-day" placeholder="Masukkan nomor Day untuk dilihat..." style="flex: 1; padding: 0.8rem 1.5rem; font-size: 1rem;" />
        <button class="btn-sm btn-accent" id="goto-btn" style="padding: 0.8rem 1.5rem;">LIHAT</button>
      </div>
      <div id="detail-content">
        <p style="text-align: center; color: var(--text-muted); padding: 4rem;">Masukkan nomor Day di atas untuk melihat detailnya.</p>
      </div>
    </div>

    <!-- Tab: Template Flashcard -->
    <div class="tab-panel" id="tab-template">
      <!-- Form Tambah -->
      <div class="tpl-form" id="tpl-form">
        <h3 id="tpl-form-title">➕ Tambah Template Baru</h3>
        <div class="tpl-row">
          <input type="text" class="tpl-input tpl-input-sm" id="tpl-nama" placeholder="Nama template (cth: Bab 1 - Kotoba)" />
          <input type="number" class="tpl-input tpl-input-sm" id="tpl-urutan" placeholder="Urutan (0, 1, 2...)" style="max-width: 140px;" />
        </div>
        <input type="text" class="tpl-input tpl-input-sm" id="tpl-deskripsi" placeholder="Deskripsi singkat (opsional)" />
        <textarea class="tpl-input tpl-textarea" id="tpl-json" placeholder='Paste data JSON flashcard...

Contoh:
[
  {"front": "犬", "back": "Anjing", "hint": "いぬ"},
  {"front": "猫", "back": "Kucing", "hint": "ねこ"}
]'></textarea>
        <div class="fc-error" id="tpl-error" style="display:none; color:#ff5252; font-size:0.9rem; padding:0.5rem 0.75rem; background:rgba(255,82,82,0.08); border:1px solid rgba(255,82,82,0.2); border-radius:6px;"></div>
        <div style="display: flex; gap: 0.75rem;">
          <button class="btn-sm btn-accent" id="tpl-btn-save" style="padding: 0.7rem 1.5rem;">SIMPAN</button>
          <button class="btn-sm" id="tpl-btn-cancel" style="padding: 0.7rem 1.5rem; display: none;">BATAL</button>
        </div>
      </div>

      <!-- Daftar Template -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0; font-size: 1.2rem;">Daftar Template</h3>
        <div style="display: flex; gap: 0.5rem;">
          <button class="btn-sm" id="btn-import-all" style="padding: 0.6rem 1.2rem;">IMPORT ALL</button>
          <button class="btn-sm btn-accent" id="btn-export-all" style="padding: 0.6rem 1.2rem;">EXPORT ALL</button>
          <input type="file" id="file-import-all" accept=".json" style="display: none;" />
        </div>
      </div>
      <div class="tpl-list" id="tpl-list">
        <p class="loading">Memuat template...</p>
      </div>
    </div>

    <!-- Tab: Template Bunpo -->
    <div class="tab-panel" id="tab-bunpo-tpl">
      <div class="tpl-form" id="bp-form">
        <h3 id="bp-form-title">➕ Tambah Template Bunpo</h3>
        <div class="tpl-row">
          <input type="text" class="tpl-input tpl-input-sm" id="bp-nama" placeholder="Nama template (cth: Bab 1 - Partikel Dasar)" />
          <input type="number" class="tpl-input tpl-input-sm" id="bp-urutan" placeholder="Urutan (0, 1, 2...)" style="max-width: 140px;" />
        </div>
        <input type="text" class="tpl-input tpl-input-sm" id="bp-deskripsi" placeholder="Deskripsi singkat (opsional)" />
        <textarea class="tpl-input tpl-textarea" id="bp-json" placeholder='Paste data JSON bunpo...

Contoh:
[
  {
    "pola": "～は～です",
    "arti": "A adalah B",
    "penjelasan": "Pola dasar untuk menyatakan identitas atau keadaan sesuatu.",
    "kapan_digunakan": "Digunakan untuk memperkenalkan diri, menjelaskan benda, atau menyatakan fakta.",
    "rumus": "Kata Benda + は + Kata Benda / Kata Sifat + です",
    "contoh": [
      { "jp": "私は学生です。", "romaji": "Watashi wa gakusei desu.", "arti": "Saya adalah pelajar.", "catatan": "Formal" },
      { "jp": "これは本です。", "romaji": "Kore wa hon desu.", "arti": "Ini adalah buku." }
    ],
    "catatan": "Partikel は dibaca 'wa' bukan 'ha'.",
    "larangan": "Jangan gunakan は setelah kata kerja.",
    "partikel": "は (wa)",
    "level": "N5",
    "kategori": "Pola Dasar"
  }
]'></textarea>
        <div class="fc-error" id="bp-error" style="display:none; color:#ff5252; font-size:0.9rem; padding:0.5rem 0.75rem; background:rgba(255,82,82,0.08); border:1px solid rgba(255,82,82,0.2); border-radius:6px;"></div>
        <div style="display: flex; gap: 0.75rem;">
          <button class="btn-sm btn-accent" id="bp-btn-save" style="padding: 0.7rem 1.5rem;">SIMPAN</button>
          <button class="btn-sm" id="bp-btn-cancel" style="padding: 0.7rem 1.5rem; display: none;">BATAL</button>
        </div>
      </div>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <h3 style="margin: 0; font-size: 1.2rem;">Daftar Template Bunpo</h3>
        <div style="display: flex; gap: 0.5rem;">
          <button class="btn-sm" id="bp-btn-import" style="padding: 0.6rem 1.2rem;">IMPORT ALL</button>
          <button class="btn-sm btn-accent" id="bp-btn-export" style="padding: 0.6rem 1.2rem;">EXPORT ALL</button>
          <input type="file" id="bp-file-import" accept=".json" style="display: none;" />
        </div>
      </div>
      <div class="tpl-list" id="bp-list">
        <p class="loading">Memuat template bunpo...</p>
      </div>
    </div>
  </div>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <!-- Confirm Dialog -->
  <div class="confirm-overlay" id="confirm-overlay">
    <div class="confirm-box">
      <h3 id="confirm-title">Konfirmasi</h3>
      <p id="confirm-msg">Apakah Anda yakin?</p>
      <div class="confirm-btns">
        <button class="btn-sm" id="confirm-cancel" style="padding: 0.75rem 2rem;">BATAL</button>
        <button class="btn-sm btn-danger" id="confirm-ok" style="padding: 0.75rem 2rem;">HAPUS</button>
      </div>
    </div>
  </div>

  <script is:inline>
    document.body.setAttribute('data-theme', 'dark');

    // Toast function
    function showToast(msg, type = 'success') {
      const t = document.getElementById('toast');
      t.className = 'toast ' + type;
      t.innerText = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 3000);
    }

    // Confirm dialog
    let confirmCallback = null;
    function showConfirm(title, msg, cb) {
      document.getElementById('confirm-title').innerText = title;
      document.getElementById('confirm-msg').innerText = msg;
      document.getElementById('confirm-overlay').classList.add('show');
      confirmCallback = cb;
    }
    document.getElementById('confirm-cancel').addEventListener('click', () => {
      document.getElementById('confirm-overlay').classList.remove('show');
      confirmCallback = null;
    });
    document.getElementById('confirm-ok').addEventListener('click', () => {
      document.getElementById('confirm-overlay').classList.remove('show');
      if (confirmCallback) confirmCallback();
      confirmCallback = null;
    });

    // Tab switching
    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
      });
    });

    // Load stats
    async function loadStats() {
      const res = await fetch('/api/manage?action=stats');
      const data = await res.json();
      document.getElementById('stat-days').innerText = data.totalDays;
      document.getElementById('stat-bunpou').innerText = data.totalBunpou;
      document.getElementById('stat-kanji').innerText = data.totalKanji;
      document.getElementById('stat-kotoba').innerText = data.totalKotoba;
    }

    // Load days list
    let allDays = [];
    async function loadDays() {
      const res = await fetch('/api/manage?action=days');
      allDays = await res.json();
      renderDays(allDays);
    }

    function renderDays(days) {
      const tbody = document.getElementById('days-tbody');
      if (days.length === 0) {
        tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:2rem;">Tidak ada data.</td></tr>';
        return;
      }
      tbody.innerHTML = days.map(d => `
        <tr>
          <td class="num">Day ${d.hari}</td>
          <td>${d.bunpou_count}</td>
          <td>${d.kanji_count}</td>
          <td>${d.kotoba_count}</td>
          <td style="font-weight:700;">${d.bunpou_count + d.kanji_count + d.kotoba_count}</td>
          <td style="text-align: right; display: flex; gap: 0.5rem; justify-content: flex-end;">
            <button class="btn-sm btn-accent" onclick="viewDay(${d.hari})">DETAIL</button>
            <button class="btn-sm btn-danger" onclick="deleteDay(${d.hari})">HAPUS</button>
          </td>
        </tr>
      `).join('');
    }

    // Filter days
    document.getElementById('filter-day').addEventListener('input', (e) => {
      const val = e.target.value.trim();
      if (!val) { renderDays(allDays); return; }
      renderDays(allDays.filter(d => String(d.hari).includes(val)));
    });

    // Delete entire day
    window.deleteDay = function(day) {
      showConfirm(
        `Hapus Day ${day}?`,
        `Semua materi (bunpou, kanji, kotoba) untuk Day ${day} akan dihapus permanen. Aksi ini tidak bisa dibatalkan!`,
        async () => {
          const res = await fetch('/api/manage', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete_day', day })
          });
          const data = await res.json();
          if (data.success) {
            showToast(data.message, 'success');
            loadDays();
            loadStats();
          } else {
            showToast('Error: ' + data.error, 'error');
          }
        }
      );
    };

    // View day detail
    window.viewDay = async function(day) {
      // Switch to detail tab
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
      document.querySelector('[data-tab="detail"]').classList.add('active');
      document.getElementById('tab-detail').classList.add('active');
      document.getElementById('goto-day').value = day;

      const container = document.getElementById('detail-content');
      container.innerHTML = '<p class="loading">Memuat detail...</p>';

      const res = await fetch(`/api/manage?action=detail&day=${day}`);
      const data = await res.json();

      let html = `
        <div class="detail-panel">
          <div class="detail-header">
            <h2>Day ${data.day}</h2>
            <button class="btn-sm btn-danger" onclick="deleteDay(${data.day})">HAPUS SEMUA DAY ${data.day}</button>
          </div>
      `;

      // Bunpou section
      html += `<div class="section-title">Bunpou / Tata Bahasa (${data.bunpou.length})</div>`;
      if (data.bunpou.length === 0) {
        html += `<p style="color:var(--text-muted); padding: 1rem;">Tidak ada data bunpou.</p>`;
      }
      data.bunpou.forEach(item => {
        html += `
          <div class="item-row">
            <div class="item-info">
              <div class="main-text">${item.pola}</div>
              <div class="sub-text">${item.penjelasan || '-'}</div>
              ${item.contoh_kalimat ? `<div class="sub-text" style="margin-top:0.5rem;">例: ${item.contoh_kalimat} → ${item.arti_contoh || ''}</div>` : ''}
            </div>
            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.5rem;">
              <span class="item-id">ID: ${item.id} | Slide: ${item.urutan_slide}</span>
              <button class="btn-sm btn-danger" onclick="deleteItem('bunpou', ${item.id}, ${data.day})">HAPUS</button>
            </div>
          </div>
        `;
      });

      // Kanji section
      html += `<div class="section-title">Kanji (${data.kanji.length})</div>`;
      if (data.kanji.length === 0) {
        html += `<p style="color:var(--text-muted); padding: 1rem;">Tidak ada data kanji.</p>`;
      }
      data.kanji.forEach(item => {
        html += `
          <div class="item-row">
            <div class="item-info">
              <div class="main-text" style="font-size: 2rem;">${item.karakter}</div>
              <div class="sub-text">ON: ${item.onyomi || '-'} | KUN: ${item.kunyomi || '-'} | Arti: ${item.arti}</div>
              ${item.contoh_kata ? `<div class="sub-text">例: ${item.contoh_kata} (${item.cara_baca_contoh}) → ${item.arti_contoh || ''}</div>` : ''}
            </div>
            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.5rem;">
              <span class="item-id">ID: ${item.id} | Slide: ${item.urutan_slide}</span>
              <button class="btn-sm btn-danger" onclick="deleteItem('kanji', ${item.id}, ${data.day})">HAPUS</button>
            </div>
          </div>
        `;
      });

      // Kotoba section
      html += `<div class="section-title">Kotoba / Kosakata (${data.kotoba.length})</div>`;
      if (data.kotoba.length === 0) {
        html += `<p style="color:var(--text-muted); padding: 1rem;">Tidak ada data kotoba.</p>`;
      }
      data.kotoba.forEach(item => {
        html += `
          <div class="item-row">
            <div class="item-info">
              <div class="main-text">${item.kata}</div>
              <div class="sub-text">${item.cara_baca} — ${item.arti}</div>
            </div>
            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:0.5rem;">
              <span class="item-id">ID: ${item.id} | Slide: ${item.urutan_slide}</span>
              <button class="btn-sm btn-danger" onclick="deleteItem('kotoba', ${item.id}, ${data.day})">HAPUS</button>
            </div>
          </div>
        `;
      });

      html += `</div>`;
      container.innerHTML = html;
    };

    // Delete single item
    window.deleteItem = function(table, id, day) {
      const label = { bunpou: 'Bunpou', kanji: 'Kanji', kotoba: 'Kotoba' }[table];
      showConfirm(
        `Hapus ${label}?`,
        `Item ID ${id} dari tabel ${label} akan dihapus permanen.`,
        async () => {
          const res = await fetch('/api/manage', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'delete_item', table, id })
          });
          const data = await res.json();
          if (data.success) {
            showToast(data.message, 'success');
            viewDay(day);
            loadStats();
            loadDays();
          } else {
            showToast('Error: ' + data.error, 'error');
          }
        }
      );
    };

    // Goto day button
    document.getElementById('goto-btn').addEventListener('click', () => {
      const val = document.getElementById('goto-day').value;
      if (val) viewDay(parseInt(val));
    });
    document.getElementById('goto-day').addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const val = e.target.value;
        if (val) viewDay(parseInt(val));
      }
    });

    /* ========== Template Flashcard CRUD ========== */
    const tplNama = document.getElementById('tpl-nama');
    const tplDeskripsi = document.getElementById('tpl-deskripsi');
    const tplJson = document.getElementById('tpl-json');
    const tplUrutan = document.getElementById('tpl-urutan');
    const tplError = document.getElementById('tpl-error');
    const tplList = document.getElementById('tpl-list');
    const tplBtnSave = document.getElementById('tpl-btn-save');
    const tplBtnCancel = document.getElementById('tpl-btn-cancel');
    const tplFormTitle = document.getElementById('tpl-form-title');
    let editingTemplateId = null;

    async function loadTemplates() {
      try {
        const res = await fetch('/api/flashcard-template?action=list');
        const templates = await res.json();
        if (!Array.isArray(templates) || templates.length === 0) {
          tplList.innerHTML = '<p style="text-align:center; color:var(--text-muted); padding:2rem;">Belum ada template. Buat template pertama di form atas.</p>';
          return;
        }
        tplList.innerHTML = templates.map(t => `
          <div class="tpl-card" data-id="${t.id}">
            <div class="tpl-card-info">
              <div class="tpl-card-name">${escapeHtmlAdmin(t.nama)}</div>
              ${t.deskripsi ? `<div class="tpl-card-desc">${escapeHtmlAdmin(t.deskripsi)}</div>` : ''}
              <div class="tpl-card-meta">${t.jumlah_kartu} kartu · Urutan: ${t.urutan}</div>
            </div>
            <div style="display: flex; gap: 0.5rem; flex-shrink: 0;">
              <a href="/flashcard/${t.id}" class="btn-sm btn-accent" style="text-decoration:none; display:inline-flex; align-items:center;">BELAJAR</a>
              <button class="btn-sm" onclick="editTemplate(${t.id})">EDIT</button>
              <button class="btn-sm btn-danger" onclick="deleteTemplate(${t.id}, '${escapeHtmlAdmin(t.nama)}')">HAPUS</button>
            </div>
          </div>
        `).join('');
      } catch (e) {
        tplList.innerHTML = '<p style="text-align:center; color:#ff5252; padding:2rem;">Gagal memuat template.</p>';
      }
    }

    function escapeHtmlAdmin(str) {
      const div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }

    function resetTemplateForm() {
      tplNama.value = '';
      tplDeskripsi.value = '';
      tplJson.value = '';
      tplUrutan.value = '';
      tplError.style.display = 'none';
      editingTemplateId = null;
      tplFormTitle.textContent = '➕ Tambah Template Baru';
      tplBtnSave.textContent = 'SIMPAN';
      tplBtnCancel.style.display = 'none';
    }

    tplBtnSave.addEventListener('click', async () => {
      const nama = tplNama.value.trim();
      const deskripsi = tplDeskripsi.value.trim();
      const jsonStr = tplJson.value.trim();
      const urutan = parseInt(tplUrutan.value) || 0;

      if (!nama) { tplError.textContent = '⚠ Nama template wajib diisi.'; tplError.style.display = 'block'; return; }
      if (!jsonStr) { tplError.textContent = '⚠ Data JSON wajib diisi.'; tplError.style.display = 'block'; return; }

      try {
        const parsed = JSON.parse(jsonStr);
        if (!Array.isArray(parsed) || parsed.length === 0) throw new Error('Data harus array JSON yang tidak kosong.');
      } catch (e) {
        tplError.textContent = '⚠ JSON tidak valid: ' + e.message;
        tplError.style.display = 'block';
        return;
      }

      try {
        let res;
        if (editingTemplateId) {
          res = await fetch('/api/flashcard-template', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: editingTemplateId, nama, deskripsi, data_json: jsonStr, urutan })
          });
        } else {
          res = await fetch('/api/flashcard-template', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nama, deskripsi, data_json: jsonStr, urutan })
          });
        }
        const result = await res.json();

        if (result.success) {
          showToast(editingTemplateId ? `Template "${nama}" berhasil diperbarui` : result.message, 'success');
          resetTemplateForm();
          loadTemplates();
        } else {
          showToast('Error: ' + result.error, 'error');
        }
      } catch (e) {
        showToast('Gagal menyimpan: ' + e.message, 'error');
      }
    });

    tplBtnCancel.addEventListener('click', resetTemplateForm);

    window.editTemplate = async function(id) {
      try {
        const res = await fetch(`/api/flashcard-template?action=detail&id=${id}`);
        const tpl = await res.json();
        if (tpl.error) { showToast(tpl.error, 'error'); return; }

        editingTemplateId = id;
        tplNama.value = tpl.nama;
        tplDeskripsi.value = tpl.deskripsi || '';
        tplUrutan.value = tpl.urutan || 0;
        tplJson.value = typeof tpl.data_json === 'string' ? tpl.data_json : JSON.stringify(tpl.data_json, null, 2);
        tplFormTitle.textContent = '✏️ Edit Template';
        tplBtnSave.textContent = 'PERBARUI';
        tplBtnCancel.style.display = '';
        tplError.style.display = 'none';
        tplNama.focus();
        document.getElementById('tpl-form').scrollIntoView({ behavior: 'smooth' });
      } catch (e) {
        showToast('Gagal memuat template: ' + e.message, 'error');
      }
    };

    window.deleteTemplate = function(id, nama) {
      showConfirm(
        `Hapus Template?`,
        `Template "${nama}" akan dihapus permanen.`,
        async () => {
          const res = await fetch('/api/flashcard-template', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });
          const data = await res.json();
          if (data.success) {
            showToast(data.message, 'success');
            loadTemplates();
          } else {
            showToast('Error: ' + data.error, 'error');
          }
        }
      );
    };

    // Export All
    document.getElementById('btn-export-all').addEventListener('click', async () => {
      try {
        const res = await fetch('/api/flashcard-template?action=export');
        const data = await res.json();

        if (!res.ok) {
          showToast(data.error || 'Gagal mengexport template', 'error');
          return;
        }

        if (!Array.isArray(data) || data.length === 0) {
          showToast('Tidak ada template untuk diexport', 'error');
          return;
        }
        
        // Parse data_json agar hasil exportnya rapi
        const formattedData = data.map(tpl => {
          let parsedData = tpl.data_json;
          try {
            if (typeof tpl.data_json === 'string') {
              parsedData = JSON.parse(tpl.data_json);
            }
          } catch (e) {
            console.warn('Gagal parse data_json untuk template:', tpl.nama);
          }
          return { ...tpl, data_json: parsedData };
        });

        const blob = new Blob([JSON.stringify(formattedData, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `flashcard_all_bab_${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast(`Export berhasil! (${formattedData.length} template)`, 'success');
      } catch (e) {
        showToast('Gagal export: ' + e.message, 'error');
      }
    });

    // Import All
    const fileImportAll = document.getElementById('file-import-all');
    document.getElementById('btn-import-all').addEventListener('click', () => {
      fileImportAll.click();
    });
    fileImportAll.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      // Validasi ekstensi file
      if (!file.name.endsWith('.json')) {
        showToast('File harus berformat .json', 'error');
        fileImportAll.value = '';
        return;
      }

      // Validasi ukuran file (max 10MB)
      if (file.size > 10 * 1024 * 1024) {
        showToast('Ukuran file terlalu besar (maks 10MB)', 'error');
        fileImportAll.value = '';
        return;
      }

      const reader = new FileReader();

      reader.onerror = () => {
        showToast('Gagal membaca file. Coba lagi.', 'error');
        fileImportAll.value = '';
      };

      reader.onload = async (ev) => {
        let json;
        try {
          json = JSON.parse(ev.target.result);
        } catch (parseErr) {
          showToast('JSON tidak valid: ' + parseErr.message, 'error');
          fileImportAll.value = '';
          return;
        }

        if (!Array.isArray(json)) {
          showToast('Format JSON harus berupa array. Contoh: [{...}, {...}]', 'error');
          fileImportAll.value = '';
          return;
        }

        if (json.length === 0) {
          showToast('File JSON kosong, tidak ada template untuk diimport', 'error');
          fileImportAll.value = '';
          return;
        }

        showConfirm('Import All Flashcard?', `Semua template lama akan DIHAPUS dan diganti dengan ${json.length} template dari file ini. Lanjutkan?`, async () => {
          try {
            const res = await fetch('/api/flashcard-template?action=importAll', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(json)
            });
            const result = await res.json();

            if (result.success) {
              showToast(result.message, 'success');
              loadTemplates();
            } else {
              const errorMsg = result.detail
                ? (Array.isArray(result.detail) ? result.detail.join(', ') : result.detail)
                : result.error;
              showToast('Error: ' + errorMsg, 'error');
            }
          } catch (fetchErr) {
            showToast('Gagal import: ' + fetchErr.message, 'error');
          }
        });

        fileImportAll.value = '';
      };

      reader.readAsText(file);
    });

    /* ========== Template Bunpo CRUD ========== */
    const bpNama = document.getElementById('bp-nama');
    const bpDeskripsi = document.getElementById('bp-deskripsi');
    const bpJson = document.getElementById('bp-json');
    const bpUrutan = document.getElementById('bp-urutan');
    const bpError = document.getElementById('bp-error');
    const bpList = document.getElementById('bp-list');
    const bpBtnSave = document.getElementById('bp-btn-save');
    const bpBtnCancel = document.getElementById('bp-btn-cancel');
    const bpFormTitle = document.getElementById('bp-form-title');
    let editingBpId = null;

    async function loadBunpoTemplates() {
      try {
        const res = await fetch('/api/bunpo-template?action=list');
        const templates = await res.json();
        if (!Array.isArray(templates) || templates.length === 0) {
          bpList.innerHTML = '<p style="text-align:center; color:var(--text-muted); padding:2rem;">Belum ada template bunpo. Buat template pertama di form atas.</p>';
          return;
        }
        bpList.innerHTML = templates.map(t => `
          <div class="tpl-card" data-id="${t.id}">
            <div class="tpl-card-info">
              <div class="tpl-card-name">${escapeHtmlAdmin(t.nama)}</div>
              ${t.deskripsi ? `<div class="tpl-card-desc">${escapeHtmlAdmin(t.deskripsi)}</div>` : ''}
              <div class="tpl-card-meta">${t.jumlah_pola} pola · Urutan: ${t.urutan}</div>
            </div>
            <div style="display: flex; gap: 0.5rem; flex-shrink: 0;">
              <button class="btn-sm" onclick="editBpTemplate(${t.id})">EDIT</button>
              <button class="btn-sm btn-danger" onclick="deleteBpTemplate(${t.id}, '${escapeHtmlAdmin(t.nama)}')">HAPUS</button>
            </div>
          </div>
        `).join('');
      } catch (e) {
        bpList.innerHTML = '<p style="text-align:center; color:#ff5252; padding:2rem;">Gagal memuat template bunpo.</p>';
      }
    }

    function resetBpForm() {
      bpNama.value = '';
      bpDeskripsi.value = '';
      bpJson.value = '';
      bpUrutan.value = '';
      bpError.style.display = 'none';
      editingBpId = null;
      bpFormTitle.textContent = '➕ Tambah Template Bunpo';
      bpBtnSave.textContent = 'SIMPAN';
      bpBtnCancel.style.display = 'none';
    }

    bpBtnSave.addEventListener('click', async () => {
      const nama = bpNama.value.trim();
      const deskripsi = bpDeskripsi.value.trim();
      const jsonStr = bpJson.value.trim();
      const urutan = parseInt(bpUrutan.value) || 0;

      if (!nama) { bpError.textContent = '⚠ Nama template wajib diisi.'; bpError.style.display = 'block'; return; }
      if (!jsonStr) { bpError.textContent = '⚠ Data JSON wajib diisi.'; bpError.style.display = 'block'; return; }

      try {
        const parsed = JSON.parse(jsonStr);
        if (!Array.isArray(parsed) || parsed.length === 0) throw new Error('Data harus array JSON yang tidak kosong.');
      } catch (e) {
        bpError.textContent = '⚠ JSON tidak valid: ' + e.message;
        bpError.style.display = 'block';
        return;
      }

      try {
        let res;
        if (editingBpId) {
          res = await fetch('/api/bunpo-template', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: editingBpId, nama, deskripsi, data_json: jsonStr, urutan })
          });
        } else {
          res = await fetch('/api/bunpo-template', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ nama, deskripsi, data_json: jsonStr, urutan })
          });
        }
        const result = await res.json();
        if (result.success) {
          showToast(editingBpId ? `Template "${nama}" berhasil diperbarui` : result.message, 'success');
          resetBpForm();
          loadBunpoTemplates();
        } else {
          showToast('Error: ' + result.error, 'error');
        }
      } catch (e) {
        showToast('Gagal menyimpan: ' + e.message, 'error');
      }
    });

    bpBtnCancel.addEventListener('click', resetBpForm);

    window.editBpTemplate = async function(id) {
      try {
        const res = await fetch(`/api/bunpo-template?action=detail&id=${id}`);
        const tpl = await res.json();
        if (tpl.error) { showToast(tpl.error, 'error'); return; }
        editingBpId = id;
        bpNama.value = tpl.nama;
        bpDeskripsi.value = tpl.deskripsi || '';
        bpUrutan.value = tpl.urutan || 0;
        bpJson.value = typeof tpl.data_json === 'string' ? tpl.data_json : JSON.stringify(tpl.data_json, null, 2);
        bpFormTitle.textContent = '✏️ Edit Template Bunpo';
        bpBtnSave.textContent = 'PERBARUI';
        bpBtnCancel.style.display = '';
        bpError.style.display = 'none';
        bpNama.focus();
        document.getElementById('bp-form').scrollIntoView({ behavior: 'smooth' });
      } catch (e) {
        showToast('Gagal memuat template: ' + e.message, 'error');
      }
    };

    window.deleteBpTemplate = function(id, nama) {
      showConfirm('Hapus Template Bunpo?', `Template "${nama}" akan dihapus permanen.`, async () => {
        const res = await fetch('/api/bunpo-template', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id })
        });
        const data = await res.json();
        if (data.success) {
          showToast(data.message, 'success');
          loadBunpoTemplates();
        } else {
          showToast('Error: ' + data.error, 'error');
        }
      });
    };

    // Export All Bunpo
    document.getElementById('bp-btn-export').addEventListener('click', async () => {
      try {
        const res = await fetch('/api/bunpo-template?action=export');
        const data = await res.json();
        if (!res.ok) { showToast(data.error || 'Gagal export', 'error'); return; }
        if (!Array.isArray(data) || data.length === 0) { showToast('Tidak ada template untuk diexport', 'error'); return; }
        const formatted = data.map(tpl => {
          let parsed = tpl.data_json;
          try { if (typeof tpl.data_json === 'string') parsed = JSON.parse(tpl.data_json); } catch {}
          return { ...tpl, data_json: parsed };
        });
        const blob = new Blob([JSON.stringify(formatted, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `bunpo_all_${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
        showToast(`Export berhasil! (${formatted.length} template)`, 'success');
      } catch (e) {
        showToast('Gagal export: ' + e.message, 'error');
      }
    });

    // Import All Bunpo
    const bpFileImport = document.getElementById('bp-file-import');
    document.getElementById('bp-btn-import').addEventListener('click', () => bpFileImport.click());
    bpFileImport.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;
      if (!file.name.endsWith('.json')) { showToast('File harus berformat .json', 'error'); bpFileImport.value = ''; return; }
      if (file.size > 10 * 1024 * 1024) { showToast('Ukuran file terlalu besar (maks 10MB)', 'error'); bpFileImport.value = ''; return; }
      const reader = new FileReader();
      reader.onerror = () => { showToast('Gagal membaca file.', 'error'); bpFileImport.value = ''; };
      reader.onload = async (ev) => {
        let json;
        try { json = JSON.parse(ev.target.result); } catch (pe) { showToast('JSON tidak valid: ' + pe.message, 'error'); bpFileImport.value = ''; return; }
        if (!Array.isArray(json)) { showToast('Format JSON harus berupa array.', 'error'); bpFileImport.value = ''; return; }
        if (json.length === 0) { showToast('File JSON kosong.', 'error'); bpFileImport.value = ''; return; }
        showConfirm('Import All Bunpo?', `Semua template bunpo lama akan DIHAPUS dan diganti dengan ${json.length} template dari file ini. Lanjutkan?`, async () => {
          try {
            const res = await fetch('/api/bunpo-template?action=importAll', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify(json)
            });
            const result = await res.json();
            if (result.success) { showToast(result.message, 'success'); loadBunpoTemplates(); }
            else { showToast('Error: ' + (result.detail || result.error), 'error'); }
          } catch (fe) { showToast('Gagal import: ' + fe.message, 'error'); }
        });
        bpFileImport.value = '';
      };
      reader.readAsText(file);
    });

    // Init
    loadStats();
    loadDays();
    loadTemplates();
    loadBunpoTemplates();
  </script>
</body>
</html>
