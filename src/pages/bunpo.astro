---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import '../styles/bunpo-global.css';
---

<Layout title="Bunpo (文法) - Pola Tata Bahasa - JPASELI">
  <div class="bp-wrap">
    <Header 
      title="文法 Bunpo" 
      subtitle="Pola Tata Bahasa Jepang" 
      icon='<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-puzzle"><path d="M19.439 7.85c-.049.322.059.648.289.878l1.568 1.568c.47.47.706 1.087.706 1.704s-.235 1.233-.706 1.704l-1.611 1.611a.98.98 0 0 1-.837.276c-.47-.07-.802-.48-.968-.925a2.501 2.501 0 1 0-3.214 3.214c.446.166.855.497.925.968a.979.979 0 0 1-.276.837l-1.61 1.611c-.47.47-1.088.706-1.705.706s-1.233-.235-1.704-.706l-1.568-1.568a1.026 1.026 0 0 0-.877-.29c-.493.074-.84.504-1.02.968a2.5 2.5 0 1 1-3.237-3.237c.464-.18.894-.527-.967-1.02a1.026 1.026 0 0 0-.289-.877l-1.568-1.568c-.47-.47-.706-1.087-.706-1.704s.235-1.233.706-1.704l1.611-1.611a.98.98 0 0 1 .837-.276c.47.07.802.48.968.925a2.501 2.501 0 1 0 3.214-3.214c-.446-.166-.855-.497-.925-.968a.979.979 0 0 1 .276-.837l1.61-1.611c.47-.47 1.088-.706 1.705-.706s1.233.235 1.704.706l1.568 1.568c.23.23.556.338.877.29.493-.074.84-.504 1.02-.968a2.5 2.5 0 1 1 3.237 3.237c-.464.18-.894.527-.967 1.02Z"/></svg>'
    />

    <!-- Search -->
    <div class="bp-search-wrapper">
      <input type="text" class="bp-search" id="bp-search" placeholder="Cari pola, arti, contoh kalimat..." />
    </div>

    <!-- Filter toolbar -->
    <div class="bp-toolbar" id="bp-toolbar">
      <span style="font-size:0.75rem; font-weight:800; letter-spacing:0.1em; color:var(--text-muted); margin-right: 0.5rem;">BAB:</span>
      <button class="bp-chip active" data-bab="all">SEMUA</button>
    </div>

    <!-- Stats -->
    <div class="bp-stats" id="bp-stats">
      <div class="bp-stat"><strong id="stat-total">0</strong> Pola</div>
      <div class="bp-stat"><strong id="stat-showing">0</strong> Ditampilkan</div>
    </div>

    <!-- Grid Container -->
    <div id="bp-container" class="bp-grid">
      <div class="bp-loading">Memuat data tata bahasa...</div>
    </div>
  </div>

  <!-- Modal Detail Bunpo -->
  <div class="bp-modal-overlay" id="bp-modal" onclick="closeModalOnBackdrop(event)">
    <div class="bp-modal-container">
      <button class="bp-modal-close" onclick="closeModal()">&times;</button>
      <div class="bp-modal-content" id="bp-modal-content">
        <!-- Bento Grid akan dirender secara dinamis -->
      </div>
    </div>
  </div>

  <script>
    import '../scripts/bunpo.js';
  </script>
</Layout>

