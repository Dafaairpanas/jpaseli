---
import '../../styles/global.css';

const { id } = Astro.params;
---

<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Flashcard - JPASELI</title>
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />
  <style is:inline>
    .fc-app {
      max-width: 900px;
      margin: 0 auto;
      padding: clamp(1.25rem, 4vw, 3rem);
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
    }

    /* Breadcrumb */
    .fc-breadcrumb {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
      flex-wrap: wrap;
    }
    .fc-breadcrumb a {
      color: var(--text-muted);
      text-decoration: none;
      transition: color 0.2s;
    }
    .fc-breadcrumb a:hover { color: var(--accent); }
    .fc-breadcrumb .separator { opacity: 0.4; }
    .fc-breadcrumb .current { color: var(--text-main); font-weight: 600; }

    .fc-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: clamp(1rem, 2vh, 1.5rem);
      border-bottom: 1px solid var(--border-color);
      padding-bottom: clamp(0.75rem, 1.5vh, 1rem);
      flex-wrap: wrap;
      gap: 0.75rem;
    }
    .fc-header h1 { 
      font-size: clamp(1.4rem, 3.5vw, 2rem); 
      font-weight: 800; 
      letter-spacing: -0.02em;
    }
    .fc-header-actions {
      display: flex;
      gap: 0.5rem;
      align-items: center;
      flex-wrap: wrap;
    }
    .btn-back {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      color: var(--text-main);
      padding: 0.45rem 1rem;
      border-radius: 8px;
      font-size: 0.85rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }
    .btn-back:hover {
      background: var(--text-main);
      color: var(--bg-secondary);
      transform: translateY(-1px);
    }

    /* Loading */
    .fc-loading {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      gap: 1rem;
      color: var(--text-muted);
      font-size: 1.1rem;
    }
    .fc-loading-spinner {
      width: 36px; height: 36px;
      border: 3px solid var(--border-color);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* Modal Opsi */
    .fc-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      z-index: 9999;
      display: none;
      justify-content: center;
      align-items: center;
      padding: 1rem;
      backdrop-filter: blur(4px);
    }
    .fc-modal-overlay.show { display: flex; }
    .fc-modal {
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 16px;
      width: 100%;
      max-width: 500px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      box-shadow: 0 10px 40px rgba(0,0,0,0.2);
      overflow: hidden;
      animation: modalIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes modalIn {
      from { transform: scale(0.95); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .fc-modal-header {
      padding: 1.25rem 1.5rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--bg-secondary);
    }
    .fc-modal-header h3 { margin: 0; font-size: 1.2rem; font-weight: 800; }
    .fc-modal-close {
      background: transparent; border: none; font-size: 1.5rem; cursor: pointer; color: var(--text-muted);
      display: flex; align-items: center; justify-content: center; padding: 0.25rem; border-radius: 50%;
    }
    .fc-modal-close:hover { background: var(--highlight-bg); color: var(--text-main); }
    .fc-modal-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; overflow-y: auto; }
    .fc-modal-section { display: flex; flex-direction: column; gap: 0.75rem; }
    .fc-modal-label { font-size: 0.85rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.05em; }
    .fc-opt-group { display: flex; flex-direction: column; gap: 0.5rem; }
    .fc-opt-card {
      display: flex; align-items: flex-start; gap: 0.75rem;
      padding: 1rem; border: 1px solid var(--border-color); border-radius: 10px;
      cursor: pointer; transition: all 0.2s; background: var(--bg-secondary);
    }
    .fc-opt-card:hover { border-color: var(--accent); }
    .fc-opt-card.active { border-color: var(--accent); background: rgba(16,185,129,0.08); box-shadow: 0 0 0 1px var(--accent); }
    .fc-opt-card input[type="radio"] { margin-top: 0.25rem; accent-color: var(--accent); }
    .fc-opt-info { display: flex; flex-direction: column; gap: 0.2rem; }
    .fc-opt-title { font-weight: 700; font-size: 1rem; }
    .fc-opt-desc { font-size: 0.8rem; color: var(--text-muted); line-height: 1.4; }
    .fc-chk-label {
      display: flex; align-items: center; gap: 0.75rem; padding: 0.75rem 1rem;
      background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px;
      cursor: pointer; font-weight: 600; font-size: 0.9rem; transition: all 0.2s;
    }
    .fc-chk-label:hover { background: var(--highlight-bg); border-color: var(--text-main); }
    .fc-chk-label input { width: 18px; height: 18px; accent-color: var(--accent); }
    .fc-modal-footer { padding: 1.25rem 1.5rem; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; gap: 1rem; background: var(--bg-secondary); }

    /* Study Section */
    .fc-study-section {
      flex: 1;
      display: none;
      flex-direction: column;
      gap: clamp(1rem, 2vh, 2rem);
    }
    .fc-progress-wrapper { display: flex; align-items: center; gap: 1rem; }
    .fc-progress-bar { flex: 1; height: 8px; background: var(--border-color); border-radius: 99px; overflow: hidden; }
    .fc-progress-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent) 0%, #34d399 100%);
      border-radius: 99px;
      transition: width 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      width: 0%;
      box-shadow: 0 0 10px rgba(16, 185, 129, 0.4);
    }
    .fc-progress-text { font-size: clamp(0.85rem, 1.5vw, 1rem); font-weight: 600; color: var(--text-muted); min-width: 60px; text-align: right; }

    /* Card */
    .fc-card-container {
      perspective: 1500px;
      width: 100%;
      min-height: clamp(300px, 55vh, 500px);
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      flex: 1;
      display: flex;
      flex-direction: column;
    }
    .fc-card {
      width: 100%;
      flex: 1;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .fc-card.flipped { transform: rotateY(180deg); }
    .fc-card-face {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      border: 1px solid var(--border-color);
      border-radius: 24px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: clamp(2rem, 4vh, 4rem) clamp(1.5rem, 4vw, 3rem);
      text-align: center;
      gap: clamp(0.75rem, 1.5vh, 1.5rem);
      overflow-y: auto;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.06);
      background: var(--bg-secondary);
      transition: box-shadow 0.3s ease;
    }
    .fc-card-face:hover { box-shadow: 0 25px 50px rgba(0, 0, 0, 0.1); }
    .fc-card-front { background: linear-gradient(145deg, var(--bg-secondary) 0%, var(--highlight-bg) 100%); }
    .fc-card-back { background: linear-gradient(145deg, var(--highlight-bg) 0%, var(--bg-secondary) 100%); transform: rotateY(180deg); }
    .fc-card-label {
      font-size: clamp(0.75rem, 1.2vw, 0.85rem); font-weight: 600; letter-spacing: 0.15em;
      text-transform: uppercase; color: var(--text-muted); position: absolute;
      top: clamp(1.25rem, 2vh, 1.5rem); left: clamp(1.25rem, 2vw, 1.5rem);
    }
    .fc-card-main {
      font-size: clamp(3rem, 8vw, 7rem); font-weight: 800; line-height: 1.2;
      word-break: break-word; max-width: 100%; color: var(--text-main);
    }
    .fc-card-main ruby { ruby-position: over; }
    .fc-card-main rt { font-size: 0.35em; color: var(--text-muted); font-weight: 500; letter-spacing: 0.05em; }
    .fc-card-sub { font-size: clamp(1.25rem, 3.5vw, 1.75rem); font-weight: 500; color: var(--text-muted); line-height: 1.5; max-width: 100%; }
    .fc-card-extra {
      font-size: clamp(0.9rem, 2vw, 1.1rem); color: var(--text-muted); font-style: italic;
      line-height: 1.6; max-width: 100%; border-top: 1px dashed var(--border-color);
      padding-top: 1rem; margin-top: 0.5rem;
    }
    .fc-card-badge-extra {
      position: absolute; top: clamp(1.25rem, 2vh, 1.5rem); right: clamp(4.5rem, 7vw, 5rem);
      background: linear-gradient(135deg, #f59e0b, #ef4444); color: #fff;
      font-size: clamp(0.65rem, 1vw, 0.75rem); font-weight: 800; padding: 0.3rem 0.6rem;
      border-radius: 8px; letter-spacing: 0.08em; text-transform: uppercase; display: none;
      box-shadow: 0 4px 10px rgba(239, 68, 68, 0.2);
    }
    .fc-flip-hint {
      position: absolute; bottom: clamp(1rem, 2vh, 1.5rem);
      font-size: clamp(0.75rem, 1.2vw, 0.85rem); color: var(--text-muted); letter-spacing: 0.02em; opacity: 0.8;
    }
    .fc-tts-btn {
      position: absolute; top: clamp(1rem, 1.5vh, 1.5rem); right: clamp(1rem, 1.5vw, 1.5rem);
      background: var(--highlight-bg); border: 1px solid var(--border-color); color: var(--text-main);
      border-radius: 50%; width: clamp(38px, 4vw, 46px); height: clamp(38px, 4vw, 46px);
      display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s ease;
    }
    .fc-tts-btn:hover { background: var(--text-main); color: var(--bg-secondary); transform: scale(1.05); }
    .fc-tts-btn svg { width: clamp(18px, 2vw, 22px); height: clamp(18px, 2vw, 22px); }

    /* Watermark */
    .fc-card-face::before {
      content: '学'; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
      font-size: clamp(10rem, 25vw, 20rem); font-weight: 900; color: var(--text-main);
      opacity: 0.03; pointer-events: none; z-index: 0;
    }
    .fc-card-main, .fc-card-sub, .fc-card-extra { position: relative; z-index: 1; }
    .fc-card-label, .fc-tts-btn, .fc-flip-hint, .fc-card-badge-extra { z-index: 1; }

    /* Buttons */
    .fc-study-actions { display: flex; flex-direction: column; gap: 1rem; width: 100%; max-width: 700px; margin: 0 auto; }
    .fc-main-actions { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(0.75rem, 2vw, 1.5rem); }
    .fc-main-actions .fc-btn { padding: clamp(0.85rem, 2vh, 1.25rem); font-size: clamp(0.95rem, 2.5vw, 1.1rem); border-radius: 16px; display: flex; align-items: center; justify-content: center; gap: 0.5rem; }
    .fc-secondary-actions { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; }
    .fc-secondary-actions .fc-btn { font-size: clamp(0.8rem, 1.5vw, 0.9rem); padding: 0.6rem 1rem; border-radius: 12px; flex: 1; }
    .fc-secondary-actions .fc-btn-icon { flex: 0 0 auto; padding: 0.6rem; border-radius: 12px; }
    .fc-secondary-actions .fc-btn-icon svg { width: 22px; height: 22px; }
    .fc-btn {
      background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-main);
      padding: clamp(0.6rem, 1.5vh, 0.85rem) clamp(1.2rem, 2vw, 2rem); font-size: clamp(0.85rem, 1.5vw, 0.95rem);
      font-weight: 700; cursor: pointer; border-radius: 99px; transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
      font-family: inherit; letter-spacing: 0.03em; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    }
    .fc-btn:hover:not(:disabled) { transform: translateY(-3px); box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08); border-color: var(--text-main); }
    .fc-btn:active:not(:disabled) { transform: translateY(-1px); }
    .fc-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .fc-btn-primary { background: linear-gradient(135deg, var(--accent) 0%, #34d399 100%); border: none; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,0.1); box-shadow: 0 4px 12px rgba(16,185,129,0.3); }
    .fc-btn-primary:hover:not(:disabled) { box-shadow: 0 8px 20px rgba(16,185,129,0.4); }
    .fc-btn-danger { color: #ef4444; border-color: rgba(239,68,68,0.3); background: rgba(239,68,68,0.05); }
    .fc-btn-danger:hover:not(:disabled) { background: #ef4444; color: #fff; border-color: #ef4444; }
    .fc-btn-success { color: #10b981; border-color: rgba(16,185,129,0.3); background: rgba(16,185,129,0.05); }
    .fc-btn-success:hover:not(:disabled) { background: #10b981; color: #fff; border-color: #10b981; }
    .fc-btn-icon { padding: clamp(0.6rem, 1.5vh, 0.85rem); display: flex; align-items: center; justify-content: center; }
    .fc-btn-icon svg { width: 20px; height: 20px; }

    /* Result */
    .fc-result {
      display: none; flex-direction: column; align-items: center; gap: clamp(1.5rem, 3vh, 2rem);
      padding: clamp(2.5rem, 4vh, 5rem) clamp(1.5rem, 3vw, 3rem); text-align: center;
      background: var(--bg-secondary); border-radius: 20px; border: 1px solid var(--border-color);
    }
    .fc-result h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; }
    .fc-result-stats { display: flex; gap: clamp(1.5rem, 4vw, 3rem); flex-wrap: wrap; justify-content: center; width: 100%; }
    .fc-stat { text-align: center; padding: 1.5rem; border-radius: 16px; background: var(--highlight-bg); flex: 1; min-width: 130px; max-width: 200px; border: 1px solid var(--border-color); }
    .fc-stat-value { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 800; margin-bottom: 0.5rem; }
    .fc-stat-label { font-size: clamp(0.75rem, 1.5vw, 0.9rem); color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; }
    .fc-stat-good .fc-stat-value { color: var(--accent); }
    .fc-stat-bad .fc-stat-value { color: #ef4444; }

    .fc-shortcuts { display: flex; gap: clamp(1rem, 2vw, 2rem); justify-content: center; flex-wrap: wrap; font-size: clamp(0.75rem, 1.2vw, 0.85rem); color: var(--text-muted); margin-top: 1rem; }
    .fc-shortcuts kbd { background: var(--bg-secondary); border: 1px solid var(--border-color); box-shadow: 0 2px 0 var(--border-color); padding: 0.25rem 0.5rem; border-radius: 6px; font-family: inherit; font-weight: 600; font-size: clamp(0.7rem, 1.1vw, 0.8rem); color: var(--text-main); }

    /* Animations */
    @keyframes slideOutLeft { 0% { transform: translateX(0) scale(1); opacity: 1; } 100% { transform: translateX(-100%) scale(0.9); opacity: 0; } }
    @keyframes slideInRight { 0% { transform: translateX(100%) scale(0.9); opacity: 0; } 100% { transform: translateX(0) scale(1); opacity: 1; } }
    @keyframes slideOutRight { 0% { transform: translateX(0) scale(1); opacity: 1; } 100% { transform: translateX(100%) scale(0.9); opacity: 0; } }
    @keyframes slideInLeft { 0% { transform: translateX(-100%) scale(0.9); opacity: 0; } 100% { transform: translateX(0) scale(1); opacity: 1; } }
    .slide-out-left { animation: slideOutLeft 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    .slide-in-right { animation: slideInRight 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    .slide-out-right { animation: slideOutRight 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    .slide-in-left { animation: slideInLeft 0.3s cubic-bezier(0.4, 0, 0.2, 1) forwards; }
    @keyframes shakeDanger { 0%, 100% { transform: translateX(0); } 20%, 60% { transform: translateX(-5px); } 40%, 80% { transform: translateX(5px); } }
    .shake-danger { animation: shakeDanger 0.4s ease; border-color: #ef4444 !important; }
    @keyframes glowSuccess { 0% { box-shadow: 0 0 0 rgba(16,185,129,0); transform: scale(1); } 50% { box-shadow: 0 0 20px rgba(16,185,129,0.8); transform: scale(1.05); } 100% { box-shadow: 0 0 0 rgba(16,185,129,0); transform: scale(1); } }
    .glow-success { animation: glowSuccess 0.4s ease; border-color: #10b981 !important; }

    @media (max-width: 480px) {
      .fc-shortcuts { display: none; }
      .fc-card-container { min-height: 350px; }
      .fc-stat { min-width: 100px; padding: 1rem; }
    }
    @media (max-height: 500px) {
      .fc-app { padding: 0.75rem 1.5rem; }
      .fc-card-container { min-height: 250px; }
      .fc-card-face { padding: 1.5rem 1rem; }
      .fc-study-section { gap: 0.75rem; }
      .fc-shortcuts { display: none; }
    }
  </style>
</head>
<body data-theme="light">
  <!-- Modal Opsi -->
  <div class="fc-modal-overlay" id="tpl-modal">
    <div class="fc-modal">
      <div class="fc-modal-header">
        <h3 id="tpl-modal-title">Opsi Belajar</h3>
        <button class="fc-modal-close" id="btn-modal-close">&times;</button>
      </div>
      <div class="fc-modal-body">
        <div class="fc-modal-section">
          <div class="fc-modal-label">Pengaturan Dasar</div>
          <label class="fc-chk-label">
            <input type="checkbox" id="modal-chk-random"> Acak Kartu (Randomize)
          </label>
          <label class="fc-chk-label">
            <input type="checkbox" id="modal-chk-reverse"> Mode Reverse (Indonesia -> Jepang)
          </label>
          <label class="fc-chk-label">
            <input type="checkbox" id="modal-chk-extra" checked> Sertakan Kosakata Ekstra
          </label>
        </div>
        <div class="fc-modal-section">
          <div class="fc-modal-label">Mode Belajar Spesial</div>
          <div class="fc-opt-group">
            <label class="fc-opt-card active" id="card-mode-normal">
              <input type="radio" name="modal-mode" value="normal" checked>
              <div class="fc-opt-info">
                <div class="fc-opt-title">Normal</div>
                <div class="fc-opt-desc">Flashcard standar. Tampil Jepang, balik jadi Indonesia.</div>
              </div>
            </label>
            <label class="fc-opt-card" id="card-mode-choukai">
              <input type="radio" name="modal-mode" value="choukai">
              <div class="fc-opt-info">
                <div class="fc-opt-title">Choukai (Listening)</div>
                <div class="fc-opt-desc">Kartu depan kosong, audio diputar otomatis. Tebak sebelum dibalik.</div>
                <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem; align-items: center;">
                  <span style="font-size: 0.75rem; font-weight: 600;">Kecepatan:</span>
                  <select id="modal-sel-speed" style="padding: 0.2rem; border-radius: 4px; background: var(--bg-primary); border: 1px solid var(--border-color); color: var(--text-main); font-size: 0.8rem;">
                    <option value="0.85">0.85x (Lambat)</option>
                    <option value="1.0" selected>1.0x (Normal)</option>
                    <option value="1.2">1.2x (Cepat)</option>
                  </select>
                </div>
              </div>
            </label>
            <label class="fc-opt-card" id="card-mode-kanji">
              <input type="radio" name="modal-mode" value="kanji">
              <div class="fc-opt-info">
                <div class="fc-opt-title">Hafalin Kanji</div>
                <div class="fc-opt-desc">Hanya menampilkan kartu yang ada Kanjinya. Hiragana disembunyikan di depan.</div>
              </div>
            </label>
          </div>
        </div>
      </div>
      <div class="fc-modal-footer">
        <button class="fc-btn" id="btn-modal-cancel">Batal</button>
        <button class="fc-btn fc-btn-primary" id="btn-modal-start">MULAI BELAJAR</button>
      </div>
    </div>
  </div>

  <div class="fc-app">
    <!-- Breadcrumb -->
    <nav class="fc-breadcrumb" id="breadcrumb">
      <a href="/">Home</a>
      <span class="separator">›</span>
      <a href="/flashcard">Flashcard</a>
      <span class="separator">›</span>
      <span class="current" id="breadcrumb-title">Memuat...</span>
    </nav>

    <header class="fc-header">
      <h1 id="page-title">Memuat...</h1>
      <div class="fc-header-actions">
        <a href="/flashcard" class="btn-back">← Daftar Bab</a>
      </div>
    </header>

    <!-- Loading State -->
    <div class="fc-loading" id="loading-section">
      <div class="fc-loading-spinner"></div>
      <span>Memuat data flashcard...</span>
    </div>

    <!-- Study Section -->
    <div class="fc-study-section" id="study-section">
      <div class="fc-progress-wrapper">
        <div class="fc-progress-bar">
          <div class="fc-progress-fill" id="progress-fill"></div>
        </div>
        <span class="fc-progress-text" id="progress-text">0 / 0</span>
      </div>

      <div class="fc-card-container" id="card-container">
        <div class="fc-card" id="flashcard">
          <div class="fc-card-face fc-card-front">
            <span class="fc-card-label">Pertanyaan</span>
            <div class="fc-card-badge-extra" id="card-front-badge">EXTRA</div>
            <button class="fc-tts-btn" id="tts-front" title="Dengarkan">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
            </button>
            <div class="fc-card-main" id="card-front-text"></div>
            <div class="fc-card-sub" id="card-front-hint" style="display:none;"></div>
            <span class="fc-flip-hint">Klik atau tekan Space untuk membalik</span>
          </div>
          <div class="fc-card-face fc-card-back">
            <span class="fc-card-label">Jawaban</span>
            <div class="fc-card-badge-extra" id="card-back-badge">EXTRA</div>
            <button class="fc-tts-btn" id="tts-back" title="Dengarkan">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
            </button>
            <div class="fc-card-main" id="card-back-text"></div>
            <div class="fc-card-sub" id="card-back-extra" style="display:none;"></div>
            <span class="fc-flip-hint">Klik untuk kembali ke depan</span>
          </div>
        </div>
      </div>

      <div class="fc-study-actions">
        <div class="fc-main-actions">
          <button class="fc-btn fc-btn-danger" id="btn-unknown">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            Belum Hafal
          </button>
          <button class="fc-btn fc-btn-success" id="btn-known">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Sudah Hafal
          </button>
        </div>
        <div class="fc-secondary-actions">
          <button class="fc-btn fc-btn-icon" id="btn-prev" title="Sebelumnya">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button class="fc-btn" id="btn-reset-study">Ulang</button>
          <button class="fc-btn" id="btn-back-list">Daftar Bab</button>
          <button class="fc-btn fc-btn-icon" id="btn-next" title="Berikutnya">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      </div>

      <div class="fc-shortcuts">
        <span><kbd>Space</kbd> Balik kartu</span>
        <span><kbd>←</kbd> Sebelumnya</span>
        <span><kbd>→</kbd> Berikutnya</span>
        <span><kbd>1</kbd> Belum hafal</span>
        <span><kbd>2</kbd> Sudah hafal</span>
      </div>
    </div>

    <!-- Result -->
    <div class="fc-result" id="result-section">
      <h2>Selesai!</h2>
      <div class="fc-result-stats">
        <div class="fc-stat fc-stat-good">
          <div class="fc-stat-value" id="stat-known">0</div>
          <div class="fc-stat-label">Sudah Hafal</div>
        </div>
        <div class="fc-stat fc-stat-bad">
          <div class="fc-stat-value" id="stat-unknown">0</div>
          <div class="fc-stat-label">Belum Hafal</div>
        </div>
        <div class="fc-stat">
          <div class="fc-stat-value" id="stat-total">0</div>
          <div class="fc-stat-label">Total Kartu</div>
        </div>
      </div>
      <div style="display: flex; gap: 1rem; flex-wrap: wrap; justify-content: center; margin-top: 1.5rem;">
        <button class="fc-btn fc-btn-primary" id="btn-retry-unknown">Ulang yang Belum Hafal</button>
        <button class="fc-btn" id="btn-retry-all">Ulang Semua</button>
        <a href="/flashcard" class="fc-btn" style="text-decoration:none;">Daftar Bab</a>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ id }}>
    const savedTheme = localStorage.getItem('app-theme') || 'light';
    document.body.setAttribute('data-theme', savedTheme);

    const PAGE_ID = id;
    const IS_COMBINED = PAGE_ID === 'combined';

    let cards = [];
    let currentIndex = 0;
    let knownSet = new Set();
    let unknownSet = new Set();
    let studyDeck = [];
    let isReverse = false;
    let studyMode = 'normal';
    let audioSpeed = 1.0;
    let transitionTimeout;

    const loadingSection = document.getElementById('loading-section');
    const studySection = document.getElementById('study-section');
    const resultSection = document.getElementById('result-section');
    const flashcard = document.getElementById('flashcard');
    const cardContainer = document.getElementById('card-container');
    const progressFill = document.getElementById('progress-fill');
    const progressText = document.getElementById('progress-text');
    const modal = document.getElementById('tpl-modal');

    /* Fetch template data */
    async function initPage() {
      try {
        let rawCards = [];
        let templateName = '';

        if (IS_COMBINED) {
          /* Data gabungan dari sessionStorage */
          const storedData = sessionStorage.getItem('fc-combined-data');
          if (!storedData) {
            window.location.href = '/flashcard?error=Data gabungan tidak ditemukan. Silakan pilih bab lagi.';
            return;
          }
          rawCards = JSON.parse(storedData);
          templateName = sessionStorage.getItem('fc-combined-label') || 'Gabungan';

          /* Check URL params for auto-start options */
          const params = new URLSearchParams(window.location.search);
          if (params.get('reverse') === '1') isReverse = true;
          if (params.get('shuffle') === '1') {
            cards = rawCards;
            setPageInfo(templateName, rawCards.length);
            loadingSection.style.display = 'none';
            startStudy(true);
            return;
          }
        } else {
          const res = await fetch(`/api/flashcard-template?action=detail&id=${PAGE_ID}`);
          const template = await res.json();

          if (template.error || !template.data_json) {
            window.location.href = '/flashcard?error=Template tidak ditemukan (ID: ' + PAGE_ID + ')';
            return;
          }

          rawCards = typeof template.data_json === 'string' ? JSON.parse(template.data_json) : template.data_json;
          templateName = template.nama || `Template ${PAGE_ID}`;
        }

        if (!Array.isArray(rawCards) || rawCards.length === 0) {
          window.location.href = '/flashcard?error=Data flashcard kosong.';
          return;
        }

        cards = rawCards;
        setPageInfo(templateName, rawCards.length);
        loadingSection.style.display = 'none';

        /* Show modal for study options */
        modal.classList.add('show');

      } catch (e) {
        window.location.href = '/flashcard?error=Gagal memuat data: ' + encodeURIComponent(e.message);
      }
    }

    function setPageInfo(name, count) {
      document.getElementById('page-title').textContent = name;
      document.getElementById('breadcrumb-title').textContent = name;
      document.title = `${name} - Flashcard | JPASELI`;
    }

    /* Modal */
    document.getElementById('btn-modal-close').addEventListener('click', () => {
      modal.classList.remove('show');
      if (studySection.style.display === 'none' || studySection.style.display === '') {
        window.location.href = '/flashcard';
      }
    });
    document.getElementById('btn-modal-cancel').addEventListener('click', () => {
      modal.classList.remove('show');
      if (studySection.style.display === 'none' || studySection.style.display === '') {
        window.location.href = '/flashcard';
      }
    });

    document.querySelectorAll('.fc-opt-card').forEach(card => {
      card.addEventListener('click', () => {
        document.querySelectorAll('.fc-opt-card').forEach(c => c.classList.remove('active'));
        card.classList.add('active');
        card.querySelector('input').checked = true;
      });
    });

    document.getElementById('btn-modal-start').addEventListener('click', () => {
      modal.classList.remove('show');
      const shuffle = document.getElementById('modal-chk-random').checked;
      isReverse = document.getElementById('modal-chk-reverse').checked;
      studyMode = document.querySelector('input[name="modal-mode"]:checked').value;
      audioSpeed = parseFloat(document.getElementById('modal-sel-speed').value);
      const includeExtra = document.getElementById('modal-chk-extra').checked;

      if (!includeExtra) {
        cards = cards.filter(c => !c.isExtra);
      }
      if (studyMode === 'kanji') {
        cards = cards.filter(c => c.hint && c.hint.trim() !== c.front.trim());
        if (cards.length === 0) {
          alert('Tidak ada kosakata dengan Kanji pada bab ini!');
          window.location.href = '/flashcard';
          return;
        }
      }
      if (cards.length === 0) {
        alert('Tidak ada kartu untuk dipelajari!');
        window.location.href = '/flashcard';
        return;
      }

      startStudy(shuffle);
    });

    function showSection(section) {
      loadingSection.style.display = 'none';
      studySection.style.display = 'none';
      resultSection.style.display = 'none';
      section.style.display = 'flex';
    }

    function shuffleArray(arr) {
      const shuffled = [...arr];
      for (let i = shuffled.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
      }
      return shuffled;
    }

    function startStudy(shuffle = false) {
      studyDeck = shuffle ? shuffleArray(cards.map((_, i) => i)) : cards.map((_, i) => i);
      currentIndex = 0;
      knownSet.clear();
      unknownSet.clear();
      showSection(studySection);
      renderCard();
    }

    function isKanji(ch) {
      const c = ch.charCodeAt(0);
      return (c >= 0x4E00 && c <= 0x9FFF) || (c >= 0x3400 && c <= 0x4DBF) || (c >= 0xF900 && c <= 0xFAFF);
    }

    function escapeHtmlChars(str) {
      const d = document.createElement('div');
      d.textContent = str;
      return d.innerHTML;
    }

    function generateFurigana(text, reading) {
      if (!reading || !text) return escapeHtmlChars(text || '');
      const chars = [...text];
      if (!chars.some(isKanji)) return escapeHtmlChars(text);
      if (chars.every(isKanji)) return `<ruby>${escapeHtmlChars(text)}<rt>${escapeHtmlChars(reading)}</rt></ruby>`;
      let result = '';
      let ti = 0, ri = 0;
      while (ti < text.length) {
        if (!isKanji(text[ti])) {
          result += escapeHtmlChars(text[ti]);
          ti++; ri++;
        } else {
          let ks = ti;
          while (ti < text.length && isKanji(text[ti])) ti++;
          const kanji = text.slice(ks, ti);
          let re;
          if (ti < text.length) { re = reading.indexOf(text[ti], ri); if (re === -1) re = reading.length; }
          else { re = reading.length; }
          result += `<ruby>${escapeHtmlChars(kanji)}<rt>${escapeHtmlChars(reading.slice(ri, re))}</rt></ruby>`;
          ri = re;
        }
      }
      return result;
    }

    function adjustFontSize(element, text) {
      const len = text.length;
      if (len < 6) element.style.fontSize = 'clamp(3rem, 8vw, 7rem)';
      else if (len < 15) element.style.fontSize = 'clamp(2.5rem, 6vw, 5rem)';
      else if (len < 30) element.style.fontSize = 'clamp(2rem, 5vw, 4rem)';
      else if (len < 50) element.style.fontSize = 'clamp(1.5rem, 4vw, 3rem)';
      else element.style.fontSize = 'clamp(1.2rem, 3vw, 2.5rem)';
    }

    function renderCard(direction = 'none') {
      if (currentIndex >= studyDeck.length) { showResults(); return; }
      clearTimeout(transitionTimeout);

      const updateContent = () => {
        const idx = studyDeck[currentIndex];
        const card = cards[idx];
        flashcard.style.transition = 'none';
        flashcard.classList.remove('flipped');
        flashcard.offsetHeight;
        flashcard.style.transition = '';

        let frontText = '', backText = '', hintText = '', extraText = '';

        if (studyMode === 'choukai') {
          frontText = '🎧 Dengarkan...'; hintText = '';
          backText = card.hint ? `${card.front} (${card.hint})` : card.front;
          extraText = card.back;
          setTimeout(() => speakText(card.hint || card.front), 400);
        } else if (studyMode === 'kanji') {
          frontText = card.front; hintText = '';
          backText = card.hint || card.front; extraText = card.back;
        } else {
          frontText = isReverse ? card.back : card.front;
          backText = isReverse ? card.front : card.back;
          hintText = isReverse ? card.extra : card.hint;
          extraText = isReverse ? card.hint : card.extra;
        }

        const canFuriganaFront = !isReverse && studyMode === 'normal' && card.hint && card.hint.trim() !== card.front.trim();
        const canFuriganaBack = isReverse && studyMode === 'normal' && card.hint && card.hint.trim() !== card.front.trim();

        const frontEl = document.getElementById('card-front-text');
        if (canFuriganaFront) { frontEl.innerHTML = generateFurigana(frontText, card.hint); hintText = ''; }
        else { frontEl.textContent = frontText; }
        adjustFontSize(frontEl, frontText);

        const hintEl = document.getElementById('card-front-hint');
        if (hintText) { hintEl.textContent = hintText; hintEl.style.display = 'block'; } else { hintEl.style.display = 'none'; }

        const backEl = document.getElementById('card-back-text');
        if (canFuriganaBack) { backEl.innerHTML = generateFurigana(card.front, card.hint); }
        else { backEl.textContent = backText; }
        adjustFontSize(backEl, backText);

        const extraEl = document.getElementById('card-back-extra');
        if (extraText) { extraEl.textContent = extraText; extraEl.style.display = 'block'; } else { extraEl.style.display = 'none'; }

        const frontBadge = document.getElementById('card-front-badge');
        const backBadge = document.getElementById('card-back-badge');
        frontBadge.style.display = card.isExtra ? 'block' : 'none';
        backBadge.style.display = card.isExtra ? 'block' : 'none';

        progressFill.style.width = ((currentIndex) / studyDeck.length * 100) + '%';
        progressText.textContent = `${currentIndex + 1} / ${studyDeck.length}`;
        document.getElementById('btn-prev').disabled = currentIndex === 0;

        if (direction === 'next') { flashcard.classList.add('slide-in-right'); transitionTimeout = setTimeout(() => flashcard.classList.remove('slide-in-right'), 300); }
        else if (direction === 'prev') { flashcard.classList.add('slide-in-left'); transitionTimeout = setTimeout(() => flashcard.classList.remove('slide-in-left'), 300); }
      };

      if (direction === 'next') { flashcard.classList.add('slide-out-left'); transitionTimeout = setTimeout(() => { flashcard.classList.remove('slide-out-left'); updateContent(); }, 250); }
      else if (direction === 'prev') { flashcard.classList.add('slide-out-right'); transitionTimeout = setTimeout(() => { flashcard.classList.remove('slide-out-right'); updateContent(); }, 250); }
      else { updateContent(); }
    }

    function markCard(known) {
      const idx = studyDeck[currentIndex];
      const btn = known ? document.getElementById('btn-known') : document.getElementById('btn-unknown');
      btn.classList.add(known ? 'glow-success' : 'shake-danger');
      setTimeout(() => btn.classList.remove('glow-success', 'shake-danger'), 400);
      if (known) { knownSet.add(idx); unknownSet.delete(idx); } else { unknownSet.add(idx); knownSet.delete(idx); }
      setTimeout(() => { currentIndex++; renderCard('next'); }, 200);
    }

    function showResults() {
      showSection(resultSection);
      document.getElementById('stat-known').textContent = knownSet.size;
      document.getElementById('stat-unknown').textContent = unknownSet.size;
      document.getElementById('stat-total').textContent = studyDeck.length;
    }

    /* Event listeners */
    cardContainer.addEventListener('click', (e) => { if (!e.target.closest('.fc-tts-btn')) flashcard.classList.toggle('flipped'); });
    document.getElementById('btn-prev').addEventListener('click', () => { if (currentIndex > 0) { currentIndex--; renderCard('prev'); } });
    document.getElementById('btn-next').addEventListener('click', () => { if (currentIndex < studyDeck.length - 1) { currentIndex++; renderCard('next'); } });
    document.getElementById('btn-known').addEventListener('click', () => markCard(true));
    document.getElementById('btn-unknown').addEventListener('click', () => markCard(false));
    document.getElementById('btn-reset-study').addEventListener('click', () => { currentIndex = 0; knownSet.clear(); unknownSet.clear(); renderCard(); });
    document.getElementById('btn-back-list').addEventListener('click', () => { window.location.href = '/flashcard'; });

    document.getElementById('btn-retry-unknown').addEventListener('click', () => {
      studyDeck = [...unknownSet]; currentIndex = 0; knownSet.clear(); unknownSet.clear(); showSection(studySection); renderCard();
    });
    document.getElementById('btn-retry-all').addEventListener('click', () => {
      studyDeck = cards.map((_, i) => i); currentIndex = 0; knownSet.clear(); unknownSet.clear(); showSection(studySection); renderCard();
    });

    /* TTS */
    function speakText(text) {
      if (!text || !window.speechSynthesis) return;
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(text);
      utterance.lang = 'ja-JP';
      utterance.rate = audioSpeed || 1.0;
      window.speechSynthesis.speak(utterance);
    }
    document.getElementById('tts-front').addEventListener('click', (e) => {
      e.stopPropagation();
      const c = cards[studyDeck[currentIndex]];
      let text = '';
      if (studyMode === 'choukai') text = (c.hint || c.front);
      else if (studyMode === 'kanji') text = c.front;
      else text = isReverse ? c.back : (c.hint || c.front);
      speakText(text);
    });
    document.getElementById('tts-back').addEventListener('click', (e) => {
      e.stopPropagation();
      const c = cards[studyDeck[currentIndex]];
      let text = '';
      if (studyMode === 'choukai') text = (c.hint || c.front);
      else if (studyMode === 'kanji') text = (c.hint || c.front);
      else text = isReverse ? (c.hint || c.front) : c.back;
      speakText(text);
    });

    /* Keyboard shortcuts */
    document.addEventListener('keydown', (e) => {
      if (studySection.style.display === 'none') return;
      if (e.key === ' ') { e.preventDefault(); flashcard.classList.toggle('flipped'); }
      if (e.key === 'ArrowLeft' && currentIndex > 0) { currentIndex--; renderCard('prev'); }
      if (e.key === 'ArrowRight' && currentIndex < studyDeck.length - 1) { currentIndex++; renderCard('next'); }
      if (e.key === '1') markCard(false);
      if (e.key === '2') markCard(true);
      if (e.key.toLowerCase() === 'p') { const c = cards[studyDeck[currentIndex]]; speakText(c.hint || c.front); }
    });

    /* Init */
    initPage();
  </script>
</body>
</html>
