---
import db from '../lib/db.js';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import '../styles/kanji-global.css';

const kanjiList = db.prepare("SELECT * FROM kanji ORDER BY urutan_slide ASC, id ASC").all();
---

<Layout title="Kamus Kanji - JPASELI">
  <div class="bp-wrap">
    <Header 
      title="Kamus Kanji" 
      subtitle={`Total: ${kanjiList.length} Kanji`} 
      icon='<svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-pen-tool"><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="m2 2 7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>'
    />

    <div class="bp-search-wrapper">
      <input type="text" class="bp-search" id="search-input" placeholder="Cari huruf kanji, onyomi, kunyomi, atau artinya..." />
    </div>

    <!-- Filter & Sort Toolbar -->
    <div class="kj-toolbar">
      <span class="kj-toolbar-label" style="margin-right: 0.5rem;">FILTER:</span>
      <button class="btn-action filter-btn active" data-filter="all" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">SEMUA</button>
      <button class="btn-action filter-btn" data-filter="learned" style="padding: 0.4rem 0.8rem; font-size: 0.75rem; border-color: var(--accent); color: var(--accent);">✓ SELESAI</button>
      <button class="btn-action filter-btn" data-filter="not-learned" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">✗ BELUM</button>
      
      <span class="kj-toolbar-label" style="margin-left: 1.5rem; margin-right: 0.5rem;">URUT:</span>
      <button class="btn-action sort-btn" data-sort="day-asc" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">DAY ↑</button>
      <button class="btn-action sort-btn" data-sort="day-desc" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">DAY ↓</button>
      <button class="btn-action sort-btn" data-sort="az" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">A → Z</button>
      <button class="btn-action sort-btn" data-sort="za" style="padding: 0.4rem 0.8rem; font-size: 0.75rem;">Z → A</button>
    </div>
    
    <main class="kj-grid" id="card-container">
      {kanjiList.map(item => (
        <div class="kj-card" data-hari={item.hari} data-arti={item.arti}>
          <strong class="kj-card-char">{item.karakter}</strong>
          <div class="kj-card-info">
            <p class="kj-card-meaning">{item.arti}</p>
            <div class="kj-card-readings">
               <span title="Onyomi">O: {item.onyomi || '-'}</span>
               <span title="Kunyomi">K: {item.kunyomi || '-'}</span>
            </div>
          </div>
        </div>
      ))}
    </main>
  </div>

  <script>
    import '../scripts/kanji.js';
  </script>
</Layout>

